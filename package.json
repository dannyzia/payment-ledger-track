{
  "name": "payment-ledger-track",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "^22.0.0",
    "pnpm": ">=9.0.0"
  },
  "scripts": {
    "dev": "pnpm --filter @clt/web dev",
    "build": "pnpm -r build",
    "test": "vitest run --passWithNoTests --no-file-parallelism",
    "test:regression": "pnpm --filter @clt/web test tests/regression/suite.test.ts",
    "test:e2e": "pnpm --filter @clt/web exec playwright test",
    "test:gates": "tsx scripts/verify-gates.ts",
    "lint": "eslint .",
    "typecheck": "tsc --build packages/calc packages/shared && pnpm --filter @clt/web check",
    "format": "prettier --check .",
    "db:bootstrap": "tsx scripts/bootstrap.ts",
    "db:seed:recon-month": "tsx scripts/seed-recon-month.ts",
    "db:reset": "supabase db reset && docker restart supabase_kong_ledger >/dev/null 2>&1 || true",
    "test:e2e:isolated": "tsx scripts/e2e/isolated-stack.ts"
  },
  "devDependencies": {
    "@playwright/test": "^1.48.2",
    "@supabase/supabase-js": "^2.46.1",
    "@types/node": "^22.8.0",
    "@types/pg": "^8.11.10",
    "dotenv": "^18.0.9",
    "eslint": "^9.14.0",
    "eslint-plugin-svelte": "^2.46.0",
    "fast-check": "^3.22.0",
    "pg": "^8.13.0",
    "prettier": "^3.3.3",
    "prettier-plugin-svelte": "^3.2.8",
    "supabase": "^1.207.0",
    "svelte": "^5.1.0",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.13.0",
    "vitest": "^2.1.4",
    "zod": "^3.23.8"
  }
}
