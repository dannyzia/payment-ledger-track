# Cosmo Ledger Track Environment Template
# No values committed to repository. Provide local values in .env.local

# Supabase Local and Hosted Credentials
PUBLIC_SUPABASE_URL=
PUBLIC_SUPABASE_ANON_KEY=
PUBLIC_API_BASE=
SUPABASE_SERVICE_ROLE_KEY=
# Supabase PostgreSQL Connection Pooler (Port 6543 Transaction mode or Port 5432 Session mode)
# Used by apps/web/src/lib/server/db.ts for the pull CTE (Plan 011)
DATABASE_URL=

# Bootstrap Runner Credentials (PRD §7.4, AGENTS.md §2)
# BOOTSTRAP_OWNER_EMAIL is the platform super_admin account, not a center owner.
BOOTSTRAP_OWNER_EMAIL=
BOOTSTRAP_OWNER_PASSWORD=

# First center provisioned by the bootstrap runner (PRD §7.4)
# Leave BOOTSTRAP_CENTER_CODE empty to provision the two development fixtures
# (MHK and RMP) instead. When it is set, every required value below must be set.
BOOTSTRAP_CENTER_CODE=
BOOTSTRAP_CENTER_NAME=
BOOTSTRAP_CENTER_LEGAL_ENTITY_NAME=
BOOTSTRAP_CENTER_ADDRESS=
BOOTSTRAP_CENTER_PHONE=
BOOTSTRAP_CENTER_OWNER_EMAIL=
BOOTSTRAP_CENTER_OWNER_NAME=
# Optional; left empty they are stored as NULL.
BOOTSTRAP_CENTER_BIN=
BOOTSTRAP_CENTER_TRADE_LICENSE=
