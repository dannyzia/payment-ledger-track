# Cosmo Ledger Track Environment Template
# No values committed to repository. Provide local values in .env.local
#
# Both the dev server and the bootstrap script read the repo-root env files with the
# same precedence: shell > .env.[mode].local > .env.[mode] > .env.local > .env

# Supabase Local and Hosted Credentials
# PUBLIC_* reach the browser bundle; the rest never leave the server.
# Server routes read SUPABASE_URL first and fall back to PUBLIC_SUPABASE_URL, so a
# hosted setup may set only the public pair (apps/web/src/lib/server/supabase.ts).
# PUBLIC_API_BASE is the native (Capacitor) build's absolute API origin.
PUBLIC_SUPABASE_URL=
PUBLIC_SUPABASE_ANON_KEY=
PUBLIC_API_BASE=
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Project JWT secret (Supabase dashboard -> Settings -> API -> JWT Secret). No
# application code reads it: it is the value CREDENTIAL_ROTATION.md needs to rotate
# tokens and the one an operator uses to verify a token by hand. Locally, `supabase
# status` prints it.
SUPABASE_JWT_SECRET=

# Supabase PostgreSQL Connection Pooler (Port 6543 Transaction mode or Port 5432 Session mode)
# Used by apps/web/src/lib/server/db.ts for the pull CTE (Plan 011)
DATABASE_URL=

# Direct Database Connection for Operations (direct port 5432, no pooler parameters).
# scripts/ops/backup-export.ts requires it and refuses to fall back to the pooler URL:
# pg_dump through a transaction pooler is not a restorable dump. Locally the direct
# connection is postgresql://postgres:postgres@127.0.0.1:54322/postgres.
DIRECT_DATABASE_URL=

# Bootstrap Runner Credentials (PRD §7.4, AGENTS.md §2)
# BOOTSTRAP_OWNER_EMAIL is the platform super_admin account, not a center owner.
BOOTSTRAP_OWNER_EMAIL=
BOOTSTRAP_OWNER_PASSWORD=

# First center provisioned by the bootstrap runner (PRD §7.4)
# Leave BOOTSTRAP_CENTER_CODE empty to provision the two development fixtures
# (MHK and RMP) instead. When it is set, every required value below must be set.
BOOTSTRAP_CENTER_CODE=
BOOTSTRAP_CENTER_NAME=
BOOTSTRAP_CENTER_LEGAL_ENTITY_NAME=
BOOTSTRAP_CENTER_ADDRESS=
BOOTSTRAP_CENTER_PHONE=
BOOTSTRAP_CENTER_OWNER_EMAIL=
BOOTSTRAP_CENTER_OWNER_NAME=
# Optional; left empty they are stored as NULL.
BOOTSTRAP_CENTER_BIN=
BOOTSTRAP_CENTER_TRADE_LICENSE=
